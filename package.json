{
  "name": "followupgc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "scripts/with-node-22.sh vite",
    "build": "scripts/with-node-22.sh sh -c 'tsc -b && vite build'",
    "lint": "scripts/with-node-22.sh eslint .",
    "preview": "scripts/with-node-22.sh vite preview",
    "functions:build": "scripts/with-node-22.sh pnpm --dir functions build",
    "functions:lint": "scripts/with-node-22.sh pnpm --dir functions lint",
    "functions:serve": "scripts/with-node-22.sh pnpm --dir functions serve",
    "functions:deploy": "scripts/with-node-22.sh pnpm --dir functions deploy",
    "test:rules": "scripts/with-node-22.sh firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:storage-rules": "scripts/with-node-22.sh firebase emulators:exec --only firestore,storage \"node --test tests/storage.rules.test.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.17.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
