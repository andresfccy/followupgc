rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/memberships/$(userId);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function meetingPath(groupId, meetingId) {
      return /databases/$(database)/documents/groups/$(groupId)/meetings/$(meetingId);
    }

    function memberPath(groupId, memberId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(memberId);
    }

    function hasActiveMembership(groupId, userId) {
      return exists(membershipPath(groupId, userId)) &&
        get(membershipPath(groupId, userId)).data.status == 'active';
    }

    function hasActiveMembershipAfter(groupId, userId) {
      return existsAfter(membershipPath(groupId, userId)) &&
        getAfter(membershipPath(groupId, userId)).data.status == 'active';
    }

    function roleFor(groupId, userId) {
      return get(membershipPath(groupId, userId)).data.role;
    }

    function isActiveMember(groupId) {
      return isSignedIn() && hasActiveMembership(groupId, request.auth.uid);
    }

    function isOwner(groupId) {
      return isActiveMember(groupId) && roleFor(groupId, request.auth.uid) == 'owner';
    }

    function isLeaderOrOwner(groupId) {
      return isActiveMember(groupId) &&
        roleFor(groupId, request.auth.uid) in ['owner', 'leader'];
    }

    function validImportRunCreate(groupId, importRunId) {
      return request.resource.data.keys().hasOnly([
        'groupId',
        'startedBy',
        'source',
        'fileName',
        'storagePath',
        'status',
        'startedAt',
        'updatedAt'
      ]) &&
      request.resource.data.groupId == groupId &&
      request.resource.data.startedBy == request.auth.uid &&
      request.resource.data.source == 'church-xlsx' &&
      request.resource.data.status == 'uploaded' &&
      request.resource.data.storagePath is string &&
      request.resource.data.storagePath == 'imports/' + groupId + '/' + importRunId + '/source.xlsx';
    }

    function validPublicMemberDoc() {
      return request.resource.data.keys().hasOnly([
        'firstName',
        'lastName',
        'fullName',
        'gender',
        'joinedAt',
        'groupRole',
        'semesterAttendances',
        'isServer',
        'isServing',
        'status',
        'documentIdHash',
        'importedFrom',
        'lastImportRunId',
        'lastImportedAt',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.firstName is string &&
      request.resource.data.firstName.size() > 0 &&
      request.resource.data.lastName is string &&
      request.resource.data.lastName.size() > 0 &&
      request.resource.data.fullName is string &&
      request.resource.data.fullName.size() > 0 &&
      (!('gender' in request.resource.data) || request.resource.data.gender in ['F', 'M']) &&
      (!('semesterAttendances' in request.resource.data) ||
        (request.resource.data.semesterAttendances is int &&
          request.resource.data.semesterAttendances >= 0)) &&
      (!('isServer' in request.resource.data) || request.resource.data.isServer is bool) &&
      (!('isServing' in request.resource.data) || request.resource.data.isServing is bool) &&
      (!('status' in request.resource.data) ||
        request.resource.data.status in ['active', 'process', 'inactive']) &&
      (!('documentIdHash' in request.resource.data) ||
        request.resource.data.documentIdHash is string);
    }

    function validPrivateProfileDoc() {
      return request.resource.data.keys().hasOnly([
        'documentId',
        'phone',
        'birthday',
        'createdAt',
        'updatedAt'
      ]) &&
      (!('documentId' in request.resource.data) || request.resource.data.documentId is string) &&
      (!('phone' in request.resource.data) || request.resource.data.phone is string) &&
      (!('birthday' in request.resource.data) || request.resource.data.birthday is string);
    }

    function validMeetingDoc() {
      return request.resource.data.keys().hasOnly([
        'date',
        'status',
        'title',
        'comment',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.date is string &&
      request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      request.resource.data.status in ['held', 'cancelled'] &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      (!('comment' in request.resource.data) || request.resource.data.comment is string) &&
      request.resource.data.createdBy is string;
    }

    function validAttendanceDoc(meetingId, memberId) {
      return request.resource.data.keys().hasOnly([
        'meetingId',
        'memberId',
        'status',
        'comment',
        'recordedBy',
        'recordedAt',
        'updatedAt'
      ]) &&
      request.resource.data.meetingId == meetingId &&
      request.resource.data.memberId == memberId &&
      request.resource.data.status in ['present', 'absent', 'excused'] &&
      request.resource.data.recordedBy is string &&
      (!('comment' in request.resource.data) || request.resource.data.comment is string);
    }

    function validPastoralNoteDoc(memberId) {
      return request.resource.data.keys().hasOnly([
        'memberId',
        'date',
        'type',
        'body',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.memberId == memberId &&
      request.resource.data.date is string &&
      request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      request.resource.data.type in ['note', 'prayer', 'care', 'milestone'] &&
      request.resource.data.body is string &&
      request.resource.data.body.size() > 0 &&
      request.resource.data.createdBy is string;
    }

    function validRole(role) {
      return role in ['owner', 'leader', 'viewer'];
    }

    function validMembershipStatus(status) {
      return status in ['active', 'inactive'];
    }

    function validUserProfileFields(userId) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'defaultGroupId',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == userId;
    }

    function validDefaultGroupCreate(userId) {
      return !('defaultGroupId' in request.resource.data) ||
        hasActiveMembershipAfter(request.resource.data.defaultGroupId, userId);
    }

    function validDefaultGroupUpdate(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['defaultGroupId']) ||
      (!('defaultGroupId' in request.resource.data) ||
        hasActiveMembershipAfter(request.resource.data.defaultGroupId, userId));
    }

    function validGroupCreate() {
      return request.resource.data.keys().hasOnly([
        'name',
        'regularWeekday',
        'createdBy',
        'createdAt',
        'updatedAt',
        'archivedAt'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 0 &&
      request.resource.data.createdBy == request.auth.uid &&
      (!('regularWeekday' in request.resource.data) ||
        request.resource.data.regularWeekday in [0, 1, 2, 3, 4, 5, 6]);
    }

    function validGroupUpdate() {
      return request.resource.data.keys().hasOnly([
        'name',
        'regularWeekday',
        'createdBy',
        'createdAt',
        'updatedAt',
        'archivedAt'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 0 &&
      request.resource.data.createdBy == resource.data.createdBy &&
      request.resource.data.createdAt == resource.data.createdAt &&
      (
        (!('archivedAt' in resource.data) && !('archivedAt' in request.resource.data)) ||
        (('archivedAt' in resource.data) && request.resource.data.archivedAt == resource.data.archivedAt)
      ) &&
      (!('regularWeekday' in request.resource.data) ||
        request.resource.data.regularWeekday in [0, 1, 2, 3, 4, 5, 6]);
    }

    function validMembershipDoc(groupId, userId) {
      return request.resource.data.keys().hasOnly([
        'groupId',
        'userId',
        'role',
        'displayName',
        'email',
        'joinedAt',
        'status',
        'updatedAt'
      ]) &&
      request.resource.data.groupId == groupId &&
      request.resource.data.userId == userId &&
      validRole(request.resource.data.role) &&
      validMembershipStatus(request.resource.data.status);
    }

    function validUserMembershipMirror(userId, groupId) {
      return request.resource.data.keys().hasOnly([
        'groupId',
        'userId',
        'groupName',
        'role',
        'displayName',
        'email',
        'joinedAt',
        'status',
        'updatedAt'
      ]) &&
      request.resource.data.groupId == groupId &&
      request.resource.data.userId == userId &&
      existsAfter(membershipPath(groupId, userId)) &&
      request.resource.data.role == getAfter(membershipPath(groupId, userId)).data.role &&
      request.resource.data.status == getAfter(membershipPath(groupId, userId)).data.status;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) &&
        validUserProfileFields(userId) &&
        validDefaultGroupCreate(userId);
      allow update: if isSelf(userId) &&
        validUserProfileFields(userId) &&
        validDefaultGroupUpdate(userId);
      allow delete: if false;

      match /groupMemberships/{groupId} {
        allow read: if isSelf(userId);
        allow create, update: if isSignedIn() &&
          isSelf(userId) &&
          validUserMembershipMirror(userId, groupId);
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if isActiveMember(groupId);
      allow create: if isSignedIn() && validGroupCreate();
      allow update: if isOwner(groupId) &&
        validGroupUpdate();
      allow delete: if false;

      match /memberships/{userId} {
        allow read: if isSelf(userId) || isActiveMember(groupId);
        allow create: if isSignedIn() &&
          validMembershipDoc(groupId, userId) &&
          isSelf(userId) &&
          request.resource.data.role == 'owner' &&
          request.resource.data.status == 'active' &&
          !exists(groupPath(groupId)) &&
          getAfter(groupPath(groupId)).data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /importRuns/{importRunId} {
        allow read: if isLeaderOrOwner(groupId);
        allow create: if isLeaderOrOwner(groupId) && validImportRunCreate(groupId, importRunId);
        allow update, delete: if false;

        match /previewRows/{rowId} {
          allow read: if isLeaderOrOwner(groupId);
          allow write: if false;
        }
      }

      match /members/{memberId} {
        allow read: if isActiveMember(groupId);
        allow create, update: if isLeaderOrOwner(groupId) && validPublicMemberDoc();
        allow delete: if false;

        match /pastoralNotes/{noteId} {
          allow read: if isLeaderOrOwner(groupId);
          allow create: if isLeaderOrOwner(groupId) &&
            exists(memberPath(groupId, memberId)) &&
            validPastoralNoteDoc(memberId) &&
            request.resource.data.createdBy == request.auth.uid;
          allow update: if isLeaderOrOwner(groupId) &&
            exists(memberPath(groupId, memberId)) &&
            validPastoralNoteDoc(memberId) &&
            request.resource.data.createdBy == resource.data.createdBy;
          allow delete: if isLeaderOrOwner(groupId);
        }

        match /private/profile {
          allow read: if isLeaderOrOwner(groupId);
          allow create, update: if isLeaderOrOwner(groupId) && validPrivateProfileDoc();
          allow delete: if false;
        }
      }

      match /meetings/{meetingId} {
        allow read: if isActiveMember(groupId);
        allow create: if isLeaderOrOwner(groupId) &&
          validMeetingDoc() &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isLeaderOrOwner(groupId) &&
          validMeetingDoc() &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;

        match /attendance/{memberId} {
          allow read: if isActiveMember(groupId);
          allow create, update: if isLeaderOrOwner(groupId) &&
            exists(meetingPath(groupId, meetingId)) &&
            get(meetingPath(groupId, meetingId)).data.status == 'held' &&
            exists(memberPath(groupId, memberId)) &&
            validAttendanceDoc(meetingId, memberId);
          allow delete: if isLeaderOrOwner(groupId);
        }
      }
    }
  }
}
