{
  "name": "followupgc-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "../scripts/with-node-22.sh tsc",
    "lint": "../scripts/with-node-22.sh tsc --noEmit",
    "test": "../scripts/with-node-22.sh sh -c 'pnpm build && node --test test/*.test.mjs'",
    "serve": "../scripts/with-node-22.sh sh -c 'pnpm build && firebase emulators:start --only functions,firestore,storage'",
    "deploy": "../scripts/with-node-22.sh firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
